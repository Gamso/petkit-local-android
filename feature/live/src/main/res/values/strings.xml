    <string name="live_snapshot_no_picture">No picture to save yet.</string>

    <!-- Talk: held to speak through the camera's speaker, walkie-talkie style. -->
    <string name="live_talk">Talk</string>
    <string name="live_talk_hold">Hold to talk</string>
    <string name="live_talk_connecting">Connecting… keep holding</string>
    <string name="live_talk_talking">Talking · release to stop</string>
    <string name="live_talk_stopping">Finishing…</string>
    <!-- Under the button while the camera plays the phone's microphone. -->
    <string name="live_talk_indicator">The camera plays what you say. Its own sound is off meanwhile.</string>
    <!-- Read by TalkBack with the button: what it is doing, and what a double tap does. -->
    <string name="live_talk_state_connecting">Connecting</string>
    <string name="live_talk_state_talking">Talking</string>
    <string name="live_talk_state_stopping">Finishing</string>
    <string name="live_talk_action_start">start talking</string>
    <string name="live_talk_action_stop">stop talking</string>
    <string name="live_talk_action_cancel">stop connecting</string>

    <!-- Under the button when the server says the camera cannot talk now. -->
    <string name="live_talk_reason_needs_patcher">Needs the Two-Way Talk patcher.</string>
    <string name="live_talk_reason_unreachable">The camera cannot be reached.</string>
    <string name="live_talk_reason_unsupported">This camera cannot talk.</string>
    <string name="live_talk_reason_server_too_old">Your petkit-local is too old to talk through a camera.</string>
    <string name="live_talk_reason_unknown">Talking through this camera is not possible now.</string>
    <!-- Said when the button is pressed anyway: what is missing, and how to fix it. -->
    <string name="live_talk_fix_needs_patcher">Apply the Two-Way Talk patcher to this camera in the petkit-local panel (Patchers tab), then try again.</string>
    <string name="live_talk_fix_unreachable">The camera has not reported its network address yet. Check that it is on and connected, then try again.</string>
    <string name="live_talk_fix_unsupported">This camera cannot talk: petkit-local has no speaker to send your voice to.</string>
    <string name="live_talk_fix_server_too_old">Update petkit-local to a version that lets the app talk through a camera.</string>
    <string name="live_talk_fix_unknown">petkit-local says talking through this camera is not possible now. Try again later.</string>

    <string name="live_talk_mic_reason">Talk needs the microphone to send your voice to the camera.</string>
    <string name="live_talk_mic_allowed">Microphone allowed. Hold Talk to speak.</string>
    <string name="live_talk_mic_denied">The microphone is not allowed. Allow it for this app in Android\'s settings to talk through the camera.</string>
    <string name="live_talk_open_settings">Open settings</string>
    <string name="live_talk_hold_hint">Keep holding Talk while you speak: it stops when you let go.</string>
    <string name="live_talk_sound_off">The camera\'s sound comes back when you stop talking.</string>

    <!-- Why a talk did not start, or stopped by itself. -->
    <string name="live_talk_error_not_a_camera">This device has no speaker to talk through.</string>
    <string name="live_talk_error_unreachable">The camera did not answer: it may be off, or another talk is holding it. Try again.</string>
    <string name="live_talk_error_busy">Someone else is talking through this camera. Try again when they stop.</string>
    <!-- %1$s is the server's own reason, in English. -->
    <string name="live_talk_error_transcoder">petkit-local could not convert your voice (%1$s).</string>
    <string name="live_talk_error_idle">Talk stopped: no sound reached the camera for 15 seconds.</string>
    <string name="live_talk_error_server_stopping">petkit-local is restarting. Try again in a moment.</string>
    <string name="live_talk_error_session">Your session has ended.</string>
    <string name="live_talk_error_refused">The server refused to open the talk.</string>
    <string name="live_talk_error_network">The connection to the camera was lost. Try again.</string>
    <string name="live_talk_error_microphone">The microphone could not be opened: another app may be using it.</string>
    <!-- %1$s is the server's own reason, in English. -->
    <string name="live_talk_error_other">Talk stopped: %1$s</string>
</resources>
