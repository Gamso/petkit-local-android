    <!-- La fenêtre du mode batterie, ouverte depuis sa tuile. -->
    <string name="fountain_battery_mode_explain">Débranchée, la fontaine passe d\'elle-même en mode batterie : la pompe fonctionne, puis se met en veille, selon les durées ci-dessous. Rebranchée, elle reprend son propre mode. Aucun des deux modes ne peut être choisi entre-temps.</string>
    <string name="fountain_battery_mode_now_on">La fontaine est sur batterie.</string>
    <string name="fountain_battery_mode_now_off">La fontaine est branchée.</string>
    <string name="fountain_battery_mode_no_settings">Le serveur ne propose aucune durée sur batterie à régler pour cette fontaine.</string>

