<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Today against yesterday, under a figure of the Today cards (litter box, fountain). An
         arrow, up or down, is drawn before the amount: "↑ 2 since yesterday", "↓ 0:25 since yesterday". -->
    <string name="today_since_yesterday">%1$s since yesterday</string>
    <string name="today_same_as_yesterday">Same as yesterday</string>
    <!-- What TalkBack reads instead of the arrow. -->
    <plurals name="today_more_than_yesterday">
        <item quantity="one">%1$d more than yesterday</item>
        <item quantity="other">%1$d more than yesterday</item>
    </plurals>
    <plurals name="today_fewer_than_yesterday">
        <item quantity="one">%1$d fewer than yesterday</item>
        <item quantity="other">%1$d fewer than yesterday</item>
    </plurals>
    <!-- %1$s is a spoken duration, "1 minute 5 seconds". -->
    <string name="today_longer_than_yesterday">%1$s longer than yesterday</string>
    <string name="today_shorter_than_yesterday">%1$s shorter than yesterday</string>
    <plurals name="today_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="today_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
</resources>
