<resources>
    <!-- A fountain's parts, on the hotspot pills and their explanations (page_*, as the other pages). -->
    <string name="page_part_water">Water level</string>
    <string name="page_part_filter">Filter</string>
    <string name="page_part_pump">Pump</string>
    <string name="page_part_battery">Battery</string>
