<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 17's local network protection: an app targeting SDK 37 needs this runtime
         permission to connect to a private address, 10.0.2.2 included; without it the packets are
         dropped and a connection times out. The debug build declares it so the end-to-end tests
         can grant it and reach the mock server (core:e2e MockServerRule). Sign-in (M1) needs it
         for a server on the LAN in every build, and asks the user for it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

</manifest>
